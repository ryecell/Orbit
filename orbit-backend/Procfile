# NOTE: unused by the current deployment. This service runs on Render as a
# Docker-type service, which uses the Dockerfile's CMD directly and does not
# read this file — the `release:` line below never actually executes there.
# This Procfile is kept only in case you ever switch to a Render native
# (non-Docker) Python service, or deploy to a Heroku-style platform that
# does honor Procfiles.
web: uvicorn main:app --host 0.0.0.0 --port $PORT --proxy-headers
release: alembic upgrade head
